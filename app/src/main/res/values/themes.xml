<resources>
    <!-- Dark only. Compose draws the UI; this just keeps the window black at launch. -->
    <style name="Theme.SMS" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Android 12+ splash screen (FEAT-3): black background, app icon, then Theme.SMS. -->
    <style name="Theme.SMS.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SMS</item>
    </style>

    <!-- No-UI trampoline (InternalLinkActivity): translucent, no animation, finishes at once. -->
    <style name="Theme.SMS.Trampoline" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
